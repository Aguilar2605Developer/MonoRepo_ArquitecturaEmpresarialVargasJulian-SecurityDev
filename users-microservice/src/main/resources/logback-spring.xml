<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Formato de una linea exigido por la rubrica:
        timestamp | LEVEL | servicio | sub=<claim> | logger | event=<nombre> | msg=<mensaje>

        "sub" viene del MDC, poblado en SecurityConfig.jwtAuthenticationConverter
        una vez que el JWT es validado, y se limpia en MdcCleanupFilter.
        "event=" y "msg=" van dentro del propio mensaje de log, de modo que
        el %msg de logback ya produce ambos campos en ese orden.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | users-microservice | sub=%X{sub:-anonymous} | %logger{36} | %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
