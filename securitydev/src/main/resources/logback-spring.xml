<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Formato de una linea exigido por la rubrica:
        timestamp | LEVEL | servicio | sub=<claim> | logger | event=<nombre> | msg=<mensaje>

        "sub" viene del MDC, poblado en SecurityConfig.jwtAuthenticationConverter
        una vez que el JWT es validado, y se limpia en MdcCleanupFilter.
        "event=" y "msg=" van dentro del propio mensaje de log (ver ejemplos
        en AdminService, CognitoService, UserService, etc.), de modo que el
        %msg de logback ya produce ambos campos en ese orden.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} | %-5level | securitydev | sub=%X{sub:-anonimo} | %logger{36} | %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- SQL y parametros de Hibernate se activan desde application.yaml
         (logging.level.org.hibernate.SQL / org.hibernate.orm.jdbc.bind)
         y salen por este mismo appender/formato. -->

</configuration>