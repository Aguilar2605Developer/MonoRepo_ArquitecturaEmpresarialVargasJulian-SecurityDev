# Copia este archivo como ".env" en la raiz del proyecto y rellena los
# valores reales. ".env" NUNCA se sube a git (ver .gitignore).
# docker-compose lee este archivo automaticamente para resolver las
# variables usadas en docker-compose.yml.

# --- Postgres de securitydev ---
SECURITYDEV_DB_NAME=securitydev
SECURITYDEV_DB_USER=securitydev_user
SECURITYDEV_DB_PASSWORD=changeme_securitydev

# --- Postgres de users-microservice ---
USERS_DB_NAME=users_db
USERS_DB_USER=users_service_user
USERS_DB_PASSWORD=changeme_users

# --- pgAdmin (Criterio 3: explorador de BD) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_pgadmin